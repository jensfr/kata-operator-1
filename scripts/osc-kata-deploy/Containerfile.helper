# OSC host-integration helper image.
# Shell-capable UBI9 image for init containers that run shell scripts
# via chroot on the host: selinux-install, guest-prep, apply-labels.
#
# Build: podman build --platform linux/amd64 \
#   -t quay.io/jensfr/osc-helper:latest \
#   -f Containerfile.helper .

FROM registry.redhat.io/ubi9/ubi-minimal:9.6

RUN microdnf install -y --nodocs coreutils-single util-linux && microdnf clean all
